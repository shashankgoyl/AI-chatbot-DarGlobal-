# Copy this file to .env for local development.
# On Render, set these as real Environment Variables in the dashboard instead.

# --- Required ---
# Get a free key at https://openrouter.ai/keys (no credit card needed).
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Model ---
# "openrouter/free" auto-routes to whatever free model OpenRouter has up
# right now. Pin a specific one instead if you want stable behaviour, e.g.
# meta-llama/llama-3.1-8b-instruct:free or google/gemma-2-9b-it:free
OPENROUTER_MODEL=openrouter/free

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
# Add your Netlify URL here once deployed, e.g.:
# ALLOWED_ORIGINS=http://localhost:5173,https://your-site.netlify.app
ALLOWED_ORIGINS=http://localhost:5173

# --- Behaviour ---
# If "true" and no vector store exists on disk yet, the app scrapes +
# embeds on first boot. Set to "false" once you've committed a pre-built
# data/vectorstore/ (recommended for production — much faster cold start).
AUTO_INGEST_ON_STARTUP=true

# Shared secret to protect POST /api/reingest. Leave blank to disable that route.
ADMIN_TOKEN=
